<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Dark Academic — navy base -->
    <color name="navy">#0F172A</color>
    <color name="navy_mid">#1E293B</color>

    <!-- Dark Academic — brass gold (cooler, less orange) -->
    <color name="gold">#C4A24A</color>
    <color name="gold_dark">#8B6B1A</color>
    <color name="gold_light">#D4BC7E</color>

    <!-- Material theme slots (used by themes.xml and component defaults) -->
    <color name="primary">#8B6B1A</color>
    <color name="primary_dark">#0F172A</color>
    <color name="primary_light">#C4A24A</color>
    <color name="primary_container">#F5E6C0</color>
    <color name="on_primary">#FAF8F5</color>
    <color name="on_primary_container">#3D2A00</color>

    <!-- Surfaces -->
    <color name="background">#0F172A</color>
    <color name="surface">#FAF8F5</color>

    <!-- Text — warm tones for the cream card -->
    <color name="text_primary">#1C1917</color>
    <color name="text_secondary">#78716C</color>
    <color name="text_hint">#A8956A</color>

    <!-- Semantic -->
    <!-- Muted salmon-red (the app's caution colour) — readable over dark wood;
         the old #DC2626 was too dark to read on the wood-glass screens. -->
    <color name="error_text">#E8A48A</color>
    <color name="success_text">#16A34A</color>
    <color name="divider">#E7DED0</color>

    <!-- Trophy Room tiers (1.2). trophy_gold_tier is deliberately distinct from the
         app's brand `gold` so "you earned Gold" doesn't just look like the app's
         usual gold accent. -->
    <color name="trophy_bronze">#CD7F32</color>
    <color name="trophy_silver">#C7CBD1</color>
    <color name="trophy_gold_tier">#E8C468</color>
    <color name="trophy_platinum">#D9E5E8</color>
    <color name="trophy_diamond">#9FDBEB</color>
    <color name="trophy_locked">#4A5568</color>
</resources>
