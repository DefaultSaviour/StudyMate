<?xml version="1.0" encoding="utf-8"?>
<!-- Tappable config box for the focus timer (0.9G). Same outlined "field" look as
     bg_glow_field but a darker fill (~10% more black) so the editable boxes read
     as distinct, pressable controls. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#2E000000" />
    <stroke
        android:width="1dp"
        android:color="#55C4A24A" />
    <corners android:radius="12dp" />
</shape>
