<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base: solid navy so the bottom is always opaque -->
    <item>
        <color android:color="#0F172A" />
    </item>

    <!-- Wood photo — scales to fill the screen -->
    <item>
        <bitmap
            android:src="@drawable/bg_wood2"
            android:gravity="fill"
            android:tileMode="disabled" />
    </item>

    <!-- Subtle dark veil so white text stays readable over the grain -->
    <item>
        <color android:color="#1A000000" />
    </item>

    <!-- Top-to-bottom fade: wood fully visible at top, 75% navy at bottom -->
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#000F172A"
                android:endColor="#BF0F172A" />
        </shape>
    </item>

</layer-list>
