<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy">

    <!-- Exam screen reuses the flashcards wood background — deck-scoped, same
         visual context. A dedicated bg_exam.jpg can replace this later. -->
    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_flashcards"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/bgOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_wood_overlay"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/headerGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.16" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/examCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="#59000000"
        app:cardForegroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:strokeColor="#99C4A24A"
        app:strokeWidth="1dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.StudyMate.LoginCard"
        app:layout_constraintWidth_max="@dimen/card_max_width"
        app:layout_constraintTop_toBottomOf="@id/headerGuide"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/examScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- ───────────── QUESTION STATE ───────────── -->
                <LinearLayout
                    android:id="@+id/questionGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="20dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/examProgressText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_text_pill_subtle"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:textColor="@color/gold_light"
                        android:textSize="13sp"
                        android:accessibilityHeading="true" />

                    <TextView
                        android:id="@+id/examQuestionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:maxLines="4"
                        android:ellipsize="end"
                        android:textColor="@color/surface"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/examOption1Btn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:maxLines="3"
                        android:textColor="@color/gold_light"
                        android:textSize="14sp"
                        android:backgroundTint="#59000000"
                        app:strokeColor="@color/gold_light"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/examOption2Btn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:maxLines="3"
                        android:textColor="@color/gold_light"
                        android:textSize="14sp"
                        android:backgroundTint="#59000000"
                        app:strokeColor="@color/gold_light"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/examOption3Btn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:maxLines="3"
                        android:textColor="@color/gold_light"
                        android:textSize="14sp"
                        android:backgroundTint="#59000000"
                        app:strokeColor="@color/gold_light"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp" />

                    <TextView
                        android:id="@+id/examMagnifyHintText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/exam_magnify_hint"
                        android:textColor="#99D4BC7E"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/examNextBtn"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="18dp"
                        android:text="@string/exam_next_button"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/navy"
                        android:backgroundTint="@color/gold" />

                </LinearLayout>

                <!-- ───────────── EMPTY STATE (not enough cards) ───────────── -->
                <LinearLayout
                    android:id="@+id/examEmptyGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="40dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/examEmptyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/exam_not_enough_cards_message"
                        android:textColor="@color/gold_light"
                        android:textSize="14sp"
                        app:drawableTopCompat="@drawable/ic_empty_state_logo"
                        android:drawablePadding="16dp"
                        app:drawableTint="#808B6B1A" />

                </LinearLayout>

                <!-- ───────────── DONE STATE (score summary) ───────────── -->
                <LinearLayout
                    android:id="@+id/examDoneGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="40dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/exam_complete_title"
                        android:textColor="@color/surface"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:accessibilityHeading="true" />

                    <TextView
                        android:id="@+id/examScoreText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:textColor="@color/gold_light"
                        android:textSize="18sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/examRetryBtn"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="28dp"
                        android:text="@string/exam_retry_button"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/navy"
                        android:backgroundTint="@color/gold" />

                </LinearLayout>

            </FrameLayout>

        </androidx.core.widget.NestedScrollView>

    </com.google.android.material.card.MaterialCardView>

    <!-- Floating orbs are generated at runtime by OrbField. -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/examBackBtn"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_arrow_back"
        app:iconTint="@color/surface"
        app:iconSize="26dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        android:backgroundTint="#59000000"
        app:strokeColor="#99C4A24A"
        app:strokeWidth="1dp"
        app:cornerRadius="26dp"
        app:rippleColor="#33D4BC7E"
        android:contentDescription="@string/cd_back"
        app:layout_constraintBottom_toTopOf="@id/examCard"
        app:layout_constraintEnd_toEndOf="@id/examCard"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
