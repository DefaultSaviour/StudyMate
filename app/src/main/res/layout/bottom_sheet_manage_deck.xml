<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/manage_deck_button"
        android:textColor="@color/surface"
        android:textSize="18sp"
        android:textStyle="bold"
        android:accessibilityHeading="true" />

    <LinearLayout
        android:id="@+id/sheetImportCsvRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:minHeight="@dimen/min_touch_target"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_subject_row"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_upload_file"
            app:tint="@color/gold_light"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="@string/import_cards_csv_button"
            android:textColor="@color/surface"
            android:textSize="15sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/sheetPasteCardsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="@dimen/min_touch_target"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_subject_row"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_content_paste"
            app:tint="@color/gold_light"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="@string/paste_cards_button"
            android:textColor="@color/surface"
            android:textSize="15sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/sheetExportShareRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="@dimen/min_touch_target"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_subject_row"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_share"
            app:tint="@color/gold_light"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="@string/export_share_deck_button"
            android:textColor="@color/surface"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>
