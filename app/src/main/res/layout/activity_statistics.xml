<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_statistics_combined">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/headerGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.16" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statsCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="#59000000"
        app:cardForegroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:strokeColor="#99C4A24A"
        app:strokeWidth="1dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.StudyMate.LoginCard"
        app:layout_constraintTop_toBottomOf="@id/headerGuide"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/statsScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="20dp"
                android:paddingBottom="0dp">

                <TextView
                    android:id="@+id/statsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Statistics"
                    android:textColor="@color/surface"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:shadowColor="#99000000"
                    android:shadowRadius="6" />

                <TextView
                    android:id="@+id/statsSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_text_pill_subtle"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Your study progress at a glance"
                    android:textColor="@color/gold_light"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/flashcardsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="FLASHCARDS"
                    android:textColor="@color/gold_light"
                    android:textSize="12sp"
                    android:letterSpacing="0.15" />

                <LinearLayout
                    android:id="@+id/flashcardStatsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/assignmentsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="ASSIGNMENTS"
                    android:textColor="@color/gold_light"
                    android:textSize="12sp"
                    android:letterSpacing="0.15" />

                <LinearLayout
                    android:id="@+id/assignmentStatsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/subjectsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="BY SUBJECT"
                    android:textColor="@color/gold_light"
                    android:textSize="12sp"
                    android:letterSpacing="0.15" />

                <LinearLayout
                    android:id="@+id/subjectProgressContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/subjectEmptyHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Add subjects and assignments to see progress here."
                    android:textColor="#B2FAF8F5"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/orb1"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/ic_subject_statistics"
        android:background="@drawable/bg_orb"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:alpha="0.42"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.08"
        android:layout_marginTop="46dp" />

    <ImageView
        android:id="@+id/orb2"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/ic_subject_math"
        android:background="@drawable/bg_orb"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:alpha="0.38"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.38"
        android:layout_marginTop="40dp" />

    <ImageView
        android:id="@+id/orb3"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_subject_psychology"
        android:background="@drawable/bg_orb"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:alpha="0.34"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.64"
        android:layout_marginTop="48dp" />

    <ImageView
        android:id="@+id/orb4"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_subject_business"
        android:background="@drawable/bg_orb"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:alpha="0.36"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.18"
        android:layout_marginTop="92dp" />

    <ImageView
        android:id="@+id/orb5"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_subject_economics"
        android:background="@drawable/bg_orb"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:alpha="0.34"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.50"
        android:layout_marginTop="86dp" />

    <ImageView
        android:id="@+id/orb7"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/ic_subject_history"
        android:background="@drawable/bg_orb"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:alpha="0.36"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.78"
        android:layout_marginTop="94dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/backBtn"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_arrow_back"
        app:iconTint="@color/surface"
        app:iconSize="26dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        android:backgroundTint="#59000000"
        app:strokeColor="#99C4A24A"
        app:strokeWidth="1dp"
        app:cornerRadius="26dp"
        app:rippleColor="#33D4BC7E"
        android:contentDescription="Back"
        app:layout_constraintBottom_toTopOf="@id/statsCard"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
