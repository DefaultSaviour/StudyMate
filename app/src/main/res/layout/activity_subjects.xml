<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_subjects_combined">

    <!-- Card starts at 16% from top — leaves a wood band for orbs + back button -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/headerGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.16" />

    <!-- ===== GLASS CARD ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/subjectsCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="#59000000"
        app:cardForegroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:strokeColor="#99C4A24A"
        app:strokeWidth="1dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.StudyMate.LoginCard"
        app:layout_constraintTop_toBottomOf="@id/headerGuide"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/cardFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true"
            android:clipToPadding="true">

            <!-- ───────────────── LIST PANEL ───────────────── -->
            <LinearLayout
                android:id="@+id/listPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp">

                <TextView
                    android:id="@+id/screenTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subjects"
                    android:textColor="@color/surface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/screenSubText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_text_pill_subtle"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Manage your study subjects"
                    android:textColor="@color/gold_light"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/createSubjectBtn"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    app:icon="@drawable/ic_add"
                    app:iconTint="@color/navy"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    android:text="Create subject"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/navy"
                    android:backgroundTint="@color/gold" />

                <TextView
                    android:id="@+id/listSectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_text_pill_subtle"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:letterSpacing="0.15"
                    android:text="YOUR SUBJECTS"
                    android:textColor="@color/gold_light"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/emptyStateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:gravity="center"
                    android:text="No subjects yet — tap Create subject to add your first one."
                    android:textColor="#B2FAF8F5"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/subjectsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:scrollbars="vertical" />

            </LinearLayout>

            <!-- ───────────────── ADD PANEL ───────────────── -->
            <ScrollView
                android:id="@+id/addPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="invisible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/addTitleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New subject"
                        android:textColor="@color/surface"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/addSubText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_text_pill_subtle"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="Pick a name and colour"
                        android:textColor="@color/gold_light"
                        android:textSize="13sp" />

                    <FrameLayout
                        android:id="@+id/addNameGlowWrap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/addSubjectNameLayout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Subject name"
                            app:boxStrokeColor="@color/box_stroke_gold"
                            app:hintTextColor="@color/gold_light"
                            android:textColorHint="#99D4BC7E">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/addSubjectNameInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="text|textCapWords"
                                android:maxLines="1"
                                android:maxLength="60"
                                android:textColor="@color/surface" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <uws.ac.uk.studymate.ui.PulseRingView
                            android:id="@+id/addNameGlow"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/addColorLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_text_pill_subtle"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:letterSpacing="0.15"
                        android:text="COLOUR"
                        android:textColor="@color/gold_light"
                        android:textSize="12sp" />

                    <FrameLayout
                        android:id="@+id/addColorGlowWrap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <LinearLayout
                            android:id="@+id/addColorRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_glow_field"
                            android:padding="8dp"
                            android:gravity="start|center_vertical"
                            android:orientation="horizontal" />

                        <uws.ac.uk.studymate.ui.PulseRingView
                            android:id="@+id/addColorGlow"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/addSaveGlowWrap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/addConfirmBtn"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="Save subject"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/navy"
                            app:cornerRadius="12dp"
                            android:backgroundTint="@color/gold" />

                        <uws.ac.uk.studymate.ui.PulseRingView
                            android:id="@+id/addSaveGlow"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/addCancelBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:text="Cancel"
                        android:textColor="@color/gold_light"
                        android:textSize="15sp"
                        app:strokeColor="@color/gold_light"
                        app:strokeWidth="1.5dp" />

                </LinearLayout>

            </ScrollView>

            <!-- ───────────────── EDIT PANEL ───────────────── -->
            <ScrollView
                android:id="@+id/editPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:visibility="invisible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/editTitleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit subject"
                        android:textColor="@color/surface"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/editSubText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_text_pill_subtle"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="Rename or recolour"
                        android:textColor="@color/gold_light"
                        android:textSize="13sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/editSubjectNameLayout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:hint="Subject name"
                        app:boxStrokeColor="@color/box_stroke_gold"
                        app:hintTextColor="@color/gold_light"
                        android:textColorHint="#99D4BC7E">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editSubjectNameInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="text|textCapWords"
                            android:maxLines="1"
                            android:maxLength="60"
                            android:textColor="@color/surface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/editColorLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_text_pill_subtle"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:letterSpacing="0.15"
                        android:text="COLOUR"
                        android:textColor="@color/gold_light"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/editColorRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="start|center_vertical"
                        android:orientation="horizontal" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/editConfirmBtn"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="28dp"
                        android:text="Save changes"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/navy"
                        android:backgroundTint="@color/gold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/editCancelBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:text="Cancel"
                        android:textColor="@color/gold_light"
                        android:textSize="15sp"
                        app:strokeColor="@color/gold_light"
                        app:strokeWidth="1.5dp" />

                </LinearLayout>

            </ScrollView>

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Floating orbs are generated at runtime by OrbField. -->

    <!-- ===== HOME ICON — outside the card, top-right (mirrors home settings) ===== -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/homeBtn"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_arrow_back"
        app:iconTint="@color/surface"
        app:iconSize="26dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        android:backgroundTint="#59000000"
        app:strokeColor="#99C4A24A"
        app:strokeWidth="1dp"
        app:cornerRadius="26dp"
        app:rippleColor="#33D4BC7E"
        android:contentDescription="Back to home"
        app:layout_constraintBottom_toTopOf="@id/subjectsCard"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
