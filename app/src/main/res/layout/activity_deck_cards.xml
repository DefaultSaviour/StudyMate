<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_deck_cards_combined">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/headerGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.16" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardsCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="#59000000"
        app:cardForegroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:strokeColor="#99C4A24A"
        app:strokeWidth="1dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.StudyMate.LoginCard"
        app:layout_constraintTop_toBottomOf="@id/headerGuide"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- ───────────── LIST PANEL (deck home) ───────────── -->
            <LinearLayout
                android:id="@+id/listPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp">

                <TextView
                    android:id="@+id/listTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/surface"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/listSubText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_text_pill_subtle"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/gold_light"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/actionRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/reviewBtn"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Start review"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/navy"
                        android:backgroundTint="@color/gold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/addCardBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:icon="@drawable/ic_add"
                        app:iconTint="@color/gold_light"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        android:gravity="center"
                        android:text="Add card"
                        android:textColor="@color/gold_light"
                        android:textSize="14sp"
                        android:backgroundTint="#59000000"
                        app:strokeColor="@color/gold_light"
                        app:strokeWidth="1.5dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/listSectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_text_pill_subtle"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:letterSpacing="0.15"
                    android:text="CARDS"
                    android:textColor="@color/gold_light"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/emptyStateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:gravity="center"
                    android:text="No cards yet — tap Add card to make your first."
                    android:textColor="#B2FAF8F5"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/cardsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:scrollbars="vertical" />

            </LinearLayout>

            <!-- ───────────── ADD PANEL (large text boxes) ───────────── -->
            <LinearLayout
                android:id="@+id/addPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:visibility="invisible">

                <TextView
                    android:id="@+id/addTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New card"
                    android:textColor="@color/surface"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/addSubText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_text_pill_subtle"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Front first, back is the answer"
                    android:textColor="@color/gold_light"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/addFrontLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="14dp"
                    android:hint="Front (question / prompt)"
                    app:boxStrokeColor="@color/box_stroke_gold"
                    app:hintTextColor="@color/gold_light"
                    android:textColorHint="#99D4BC7E">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/addFrontInput"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="top|start"
                        android:imeOptions="actionDone"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="500"
                        android:textColor="@color/surface" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/addBackLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="12dp"
                    android:hint="Back (answer)"
                    app:boxStrokeColor="@color/box_stroke_gold"
                    app:hintTextColor="@color/gold_light"
                    android:textColorHint="#99D4BC7E">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/addBackInput"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="top|start"
                        android:imeOptions="actionDone"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="500"
                        android:textColor="@color/surface" />

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/addCancelBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Cancel"
                        android:textColor="@color/gold_light"
                        android:textSize="14sp"
                        app:strokeColor="@color/gold_light"
                        app:strokeWidth="1.5dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/addConfirmBtn"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Save card"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/navy"
                        android:backgroundTint="@color/gold" />

                </LinearLayout>

            </LinearLayout>

            <!-- ───────────── EDIT PANEL (large text boxes) ───────────── -->
            <LinearLayout
                android:id="@+id/editPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:visibility="invisible">

                <TextView
                    android:id="@+id/editTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit card"
                    android:textColor="@color/surface"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/editSubText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_text_pill_subtle"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Update the front or back text"
                    android:textColor="@color/gold_light"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/editFrontLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="14dp"
                    android:hint="Front (question / prompt)"
                    app:boxStrokeColor="@color/box_stroke_gold"
                    app:hintTextColor="@color/gold_light"
                    android:textColorHint="#99D4BC7E">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editFrontInput"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="top|start"
                        android:imeOptions="actionDone"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="500"
                        android:textColor="@color/surface" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/editBackLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="12dp"
                    android:hint="Back (answer)"
                    app:boxStrokeColor="@color/box_stroke_gold"
                    app:hintTextColor="@color/gold_light"
                    android:textColorHint="#99D4BC7E">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editBackInput"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="top|start"
                        android:imeOptions="actionDone"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="500"
                        android:textColor="@color/surface" />

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/editCancelBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Cancel"
                        android:textColor="@color/gold_light"
                        android:textSize="14sp"
                        app:strokeColor="@color/gold_light"
                        app:strokeWidth="1.5dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/editConfirmBtn"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Save changes"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/navy"
                        android:backgroundTint="@color/gold" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/orb1"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_subject_english"
        android:background="@drawable/bg_orb"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:alpha="0.40"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.10"
        android:layout_marginTop="46dp" />

    <ImageView
        android:id="@+id/orb2"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_subject_history"
        android:background="@drawable/bg_orb"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:alpha="0.36"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.48"
        android:layout_marginTop="38dp" />

    <ImageView
        android:id="@+id/orb3"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/ic_subject_languages"
        android:background="@drawable/bg_orb"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:alpha="0.36"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.82"
        android:layout_marginTop="88dp" />

    <ImageView
        android:id="@+id/orb4"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:src="@drawable/ic_subject_philosophy"
        android:background="@drawable/bg_orb"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:alpha="0.34"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.26"
        android:layout_marginTop="94dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/backBtn"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_arrow_back"
        app:iconTint="@color/surface"
        app:iconSize="26dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        android:backgroundTint="#59000000"
        app:strokeColor="#99C4A24A"
        app:strokeWidth="1dp"
        app:cornerRadius="26dp"
        app:rippleColor="#33D4BC7E"
        android:contentDescription="Back"
        app:layout_constraintBottom_toTopOf="@id/cardsCard"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
