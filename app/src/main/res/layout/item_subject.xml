<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_subject_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <View
        android:id="@+id/colorDot"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:background="@drawable/bg_color_dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/subjectNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/assignmentCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/gold_light"
            android:textSize="12sp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/editBtn"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:contentDescription="Edit subject"
        app:icon="@drawable/ic_edit"
        app:iconTint="@color/gold_light"
        app:iconSize="20dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        android:backgroundTint="#00000000"
        app:rippleColor="#33D4BC7E" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/deleteBtn"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:contentDescription="Delete subject"
        app:icon="@drawable/ic_delete"
        app:iconTint="#E8A48A"
        app:iconSize="20dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        android:backgroundTint="#00000000"
        app:rippleColor="#44E8A48A" />

</LinearLayout>
