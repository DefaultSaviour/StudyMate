<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy">

    <!-- Wood photo, centerCrop so it never stretches (esp. on wide/tablet screens) -->
    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_assignments"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Veil + bottom navy fade over the photo -->
    <View
        android:id="@+id/bgOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_wood_overlay"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/headerGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.16" />

    <!-- ===== GLASS CARD ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/assignmentsCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="#59000000"
        app:cardForegroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:strokeColor="#99C4A24A"
        app:strokeWidth="1dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.StudyMate.LoginCard"
        app:layout_constraintWidth_max="@dimen/card_max_width"
        app:layout_constraintTop_toBottomOf="@id/headerGuide"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true"
            android:clipToPadding="true">

            <!-- ───────────── LIST PANEL ───────────── -->
            <LinearLayout
                android:id="@+id/listPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp">

                <TextView
                    android:id="@+id/listTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assignments"
                    android:textColor="@color/surface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/listSubText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_text_pill_subtle"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Track everything that's coming up"
                    android:textColor="@color/gold_light"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/createAssignmentBtn"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    app:icon="@drawable/ic_add"
                    app:iconTint="@color/navy"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    android:text="Create assignment"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/navy"
                    android:backgroundTint="@color/gold" />

                <TextView
                    android:id="@+id/listSectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_text_pill_subtle"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:letterSpacing="0.15"
                    android:text="UPCOMING"
                    android:textColor="@color/gold_light"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/emptyStateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:gravity="center"
                    android:text="No assignments yet — tap Create assignment to add one."
                    android:textColor="@color/gold_light"
                    android:textSize="14sp"
                    app:drawableTopCompat="@drawable/ic_empty_state_logo"
                    android:drawablePadding="16dp"
                    app:drawableTint="#808B6B1A"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/assignmentsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:scrollbars="vertical" />

            </LinearLayout>

            <!-- ───────────── ADD PANEL ───────────── -->
            <ScrollView
                android:id="@+id/addPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="invisible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/addTitleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New assignment"
                        android:textColor="@color/surface"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/addSubText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_text_pill_subtle"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="Fill in name, colour and due date"
                        android:textColor="@color/gold_light"
                        android:textSize="13sp" />

                    <FrameLayout
                        android:id="@+id/addTitleGlowWrap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/addTitleLayout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Assignment name"
                            app:boxStrokeColor="@color/box_stroke_gold"
                            app:hintTextColor="@color/gold_light"
                            android:textColorHint="#99D4BC7E">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/addTitleInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="text|textCapSentences"
                                android:maxLines="1"
                                android:maxLength="100"
                                android:textColor="@color/surface" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <uws.ac.uk.studymate.ui.PulseRingView
                            android:id="@+id/addTitleGlow"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/addSubjectLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_text_pill_subtle"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:letterSpacing="0.15"
                        android:text="COLOUR"
                        android:textColor="@color/gold_light"
                        android:textSize="12sp" />

                    <FrameLayout
                        android:id="@+id/addSubjectGlowWrap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <!-- Colours laid out in fixed rows (built in code) so they
                             never need a horizontal scroll. -->
                        <LinearLayout
                            android:id="@+id/addSubjectRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_glow_field"
                            android:padding="8dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical" />

                        <uws.ac.uk.studymate.ui.PulseRingView
                            android:id="@+id/addSubjectGlow"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/addIconLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_text_pill_subtle"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:letterSpacing="0.15"
                        android:text="ICON"
                        android:textColor="@color/gold_light"
                        android:textSize="12sp" />

                    <FrameLayout
                        android:id="@+id/addIconGlowWrap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/addPickIconBtn"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:text="Choose icon"
                            android:textColor="@color/gold_light"
                            android:textSize="15sp"
                            android:backgroundTint="#59000000"
                            android:enabled="false"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/gold_light"
                            app:strokeWidth="1.5dp" />

                        <uws.ac.uk.studymate.ui.PulseRingView
                            android:id="@+id/addIconGlow"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/addDueLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_text_pill_subtle"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:letterSpacing="0.15"
                        android:text="DUE DATE"
                        android:textColor="@color/gold_light"
                        android:textSize="12sp" />

                    <FrameLayout
                        android:id="@+id/addDueGlowWrap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/addPickDueBtn"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:text="Pick due date"
                            android:textColor="@color/gold_light"
                            android:textSize="15sp"
                            android:backgroundTint="#59000000"
                            android:enabled="false"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/gold_light"
                            app:strokeWidth="1.5dp" />

                        <uws.ac.uk.studymate.ui.PulseRingView
                            android:id="@+id/addDueGlow"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/addSaveGlowWrap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/addConfirmBtn"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="Save assignment"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/navy"
                            app:cornerRadius="12dp"
                            android:backgroundTint="@color/gold" />

                        <uws.ac.uk.studymate.ui.PulseRingView
                            android:id="@+id/addSaveGlow"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/addCancelBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:text="Cancel"
                        android:textColor="@color/gold_light"
                        android:textSize="15sp"
                        app:strokeColor="@color/gold_light"
                        app:strokeWidth="1.5dp" />

                </LinearLayout>

            </ScrollView>

            <!-- ───────────── EDIT PANEL ───────────── -->
            <ScrollView
                android:id="@+id/editPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:visibility="invisible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/editTitleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit assignment"
                        android:textColor="@color/surface"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/editSubText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_text_pill_subtle"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="Update any field"
                        android:textColor="@color/gold_light"
                        android:textSize="13sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/editTitleLayout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:hint="Assignment name"
                        app:boxStrokeColor="@color/box_stroke_gold"
                        app:hintTextColor="@color/gold_light"
                        android:textColorHint="#99D4BC7E">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTitleInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="text|textCapSentences"
                            android:maxLines="1"
                            android:maxLength="100"
                            android:textColor="@color/surface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/editSubjectLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_text_pill_subtle"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:letterSpacing="0.15"
                        android:text="COLOUR"
                        android:textColor="@color/gold_light"
                        android:textSize="12sp" />

                    <!-- Colours in fixed rows (built in code), never a horizontal scroll. -->
                    <LinearLayout
                        android:id="@+id/editSubjectRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_glow_field"
                        android:padding="8dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/editIconLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_text_pill_subtle"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:letterSpacing="0.15"
                        android:text="ICON"
                        android:textColor="@color/gold_light"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/editPickIconBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Edit icon"
                        android:textColor="@color/gold_light"
                        android:textSize="15sp"
                        android:backgroundTint="#59000000"
                        app:strokeColor="@color/gold_light"
                        app:strokeWidth="1.5dp" />

                    <TextView
                        android:id="@+id/editDueLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_text_pill_subtle"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:letterSpacing="0.15"
                        android:text="DUE DATE"
                        android:textColor="@color/gold_light"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/editPickDueBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Edit due date"
                        android:textColor="@color/gold_light"
                        android:textSize="15sp"
                        android:backgroundTint="#59000000"
                        app:strokeColor="@color/gold_light"
                        app:strokeWidth="1.5dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/editConfirmBtn"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="20dp"
                        android:text="Save changes"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/navy"
                        android:backgroundTint="@color/gold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/editCancelBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:text="Cancel"
                        android:textColor="@color/gold_light"
                        android:textSize="15sp"
                        app:strokeColor="@color/gold_light"
                        app:strokeWidth="1.5dp" />

                </LinearLayout>

            </ScrollView>

            <!-- ───────────── DATE PICKER PANEL ───────────── -->
            <LinearLayout
                android:id="@+id/datePanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:visibility="invisible">

                <FrameLayout
                    android:id="@+id/dateContent"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:theme="@style/Theme.StudyMate.DateTimePicker">

                    <DatePicker
                        android:id="@+id/datePanelDatePicker"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:calendarViewShown="true"
                        android:datePickerMode="calendar"
                        android:spinnersShown="false" />

                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dateNextBtn"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="Next: pick time"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/navy"
                    android:backgroundTint="@color/gold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dateCancelBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:text="Cancel"
                    android:textColor="@color/gold_light"
                    android:textSize="15sp"
                    app:strokeColor="@color/gold_light"
                    app:strokeWidth="1.5dp" />

            </LinearLayout>

            <!-- ───────────── TIME PICKER PANEL ───────────── -->
            <LinearLayout
                android:id="@+id/timePanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:visibility="invisible">

                <FrameLayout
                    android:id="@+id/timeContent"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:theme="@style/Theme.StudyMate.DateTimePicker">

                    <TimePicker
                        android:id="@+id/timePanelTimePicker"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:timePickerMode="clock" />

                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/timeConfirmBtn"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="Set due date"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/navy"
                    android:backgroundTint="@color/gold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/timeBackBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:text="Back to date"
                    android:textColor="@color/gold_light"
                    android:textSize="15sp"
                    app:strokeColor="@color/gold_light"
                    app:strokeWidth="1.5dp" />

            </LinearLayout>

            <!-- ───────────── ICON PICKER PANEL ───────────── -->
            <LinearLayout
                android:id="@+id/iconPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:visibility="invisible">

                <TextView
                    android:id="@+id/iconPanelTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose icon"
                    android:textColor="@color/surface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/iconPanelSubText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_text_pill_subtle"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Tap one to attach it"
                    android:textColor="@color/gold_light"
                    android:textSize="13sp" />

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/iconScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="14dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:scrollbars="vertical">

                    <LinearLayout
                        android:id="@+id/iconGridContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp" />

                </androidx.core.widget.NestedScrollView>

            </LinearLayout>

            <!-- ───────────── CHECKLIST PANEL ───────────── -->
            <LinearLayout
                android:id="@+id/checklistPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:visibility="invisible">

                <LinearLayout
                    android:id="@+id/checklistHeaderRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/checklistIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/checklistTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Checklist"
                        android:textColor="@color/surface"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/checklistSubText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_text_pill_subtle"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="0 of 0 done"
                    android:textColor="@color/gold_light"
                    android:textSize="13sp" />

                <!-- Weighted region reserves the list space in BOTH states, so the
                     add field + Back stay pinned at the bottom whether empty or not. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/checklistRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:scrollbars="vertical" />

                    <TextView
                        android:id="@+id/checklistEmptyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="No items yet — add the steps for this assignment below."
                        android:textColor="@color/gold_light"
                        android:textSize="14sp"
                        app:drawableTopCompat="@drawable/ic_empty_state_logo"
                        android:drawablePadding="16dp"
                        app:drawableTint="#808B6B1A"
                        android:visibility="gone" />

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/checklistAddRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/checklistAddLayout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Add a checklist item…"
                        app:boxBackgroundColor="#40000000"
                        app:boxStrokeColor="@color/box_stroke_gold"
                        app:hintTextColor="@color/gold_light"
                        android:textColorHint="#D4BC7E">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/checklistAddInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text|textCapSentences"
                            android:maxLines="1"
                            android:maxLength="120"
                            android:imeOptions="actionDone"
                            android:textColor="@color/surface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/checklistAddBtn"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="@dimen/min_touch_target"
                        android:layout_height="@dimen/min_touch_target"
                        android:layout_marginStart="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:icon="@drawable/ic_add"
                        app:iconTint="@color/gold"
                        app:iconSize="24dp"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        android:backgroundTint="#00000000"
                        app:rippleColor="#33D4BC7E"
                        android:contentDescription="@string/cd_add_task" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/checklistBackBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="Back"
                    android:textColor="@color/gold_light"
                    app:strokeColor="@color/gold_light"
                    app:strokeWidth="1.5dp" />

            </LinearLayout>

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Floating orbs are generated at runtime by OrbField. -->

    <!-- ===== Back-to-home icon outside the card ===== -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/homeBtn"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_arrow_back"
        app:iconTint="@color/surface"
        app:iconSize="26dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        android:backgroundTint="#59000000"
        app:strokeColor="#99C4A24A"
        app:strokeWidth="1dp"
        app:cornerRadius="26dp"
        app:rippleColor="#33D4BC7E"
        android:contentDescription="@string/cd_back_home"
        app:layout_constraintBottom_toTopOf="@id/assignmentsCard"
        app:layout_constraintEnd_toEndOf="@id/assignmentsCard"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
