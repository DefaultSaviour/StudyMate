<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_subject_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/taskCheckBtn"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="@dimen/min_touch_target"
        android:layout_height="@dimen/min_touch_target"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_circle_outline"
        app:iconTint="@color/gold_light"
        app:iconSize="22dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        android:backgroundTint="#00000000"
        app:rippleColor="#33D4BC7E" />

    <TextView
        android:id="@+id/taskText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/surface"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/taskDeleteBtn"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="@dimen/min_touch_target"
        android:layout_height="@dimen/min_touch_target"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_delete"
        app:iconTint="#E8A48A"
        app:iconSize="18dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        android:backgroundTint="#00000000"
        app:rippleColor="#44E8A48A" />

</LinearLayout>
