<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_subject_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <FrameLayout
        android:id="@+id/iconBadge"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_icon_badge">

        <ImageView
            android:id="@+id/iconImage"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/assignmentTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/assignmentSubjectText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/gold_light"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/assignmentDueText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="#B2FAF8F5"
            android:textSize="12sp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/editBtn"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:contentDescription="Edit assignment"
        app:icon="@drawable/ic_edit"
        app:iconTint="@color/gold_light"
        app:iconSize="18dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        android:backgroundTint="#00000000"
        app:rippleColor="#33D4BC7E" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/deleteBtn"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:contentDescription="Delete assignment"
        app:icon="@drawable/ic_delete"
        app:iconTint="#E8A48A"
        app:iconSize="18dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        android:backgroundTint="#00000000"
        app:rippleColor="#44E8A48A" />

</LinearLayout>
