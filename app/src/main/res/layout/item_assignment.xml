<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_subject_row"
    android:paddingHorizontal="12dp"
    android:paddingVertical="16dp">

    <!-- Title spans above icon and due text -->
    <TextView
        android:id="@+id/assignmentTitleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/surface"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/buttonGrid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Icon is below the title -->
    <FrameLayout
        android:id="@+id/iconBadge"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_icon_badge"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/assignmentTitleText">

        <ImageView
            android:id="@+id/iconImage"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- Due Date is next to the icon -->
    <TextView
        android:id="@+id/assignmentDueText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:textColor="#B2FAF8F5"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/iconBadge"
        app:layout_constraintEnd_toStartOf="@+id/buttonGrid"
        app:layout_constraintStart_toEndOf="@+id/iconBadge"
        app:layout_constraintTop_toTopOf="@+id/iconBadge" />

    <!-- 2x2 Button Grid on the right -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttonGrid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/doneBtn"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/min_touch_target"
            android:layout_height="@dimen/min_touch_target"
            android:backgroundTint="#00000000"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_circle_outline"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp"
            app:iconTint="@color/gold_light"
            app:layout_constraintBottom_toTopOf="@+id/hDivider"
            app:layout_constraintEnd_toStartOf="@+id/vDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rippleColor="#33D4BC7E" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/checklistBtn"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/min_touch_target"
            android:layout_height="@dimen/min_touch_target"
            android:backgroundTint="#00000000"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_checklist"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp"
            app:iconTint="@color/gold_light"
            app:layout_constraintBottom_toTopOf="@+id/hDivider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/vDivider"
            app:layout_constraintTop_toTopOf="parent"
            app:rippleColor="#33D4BC7E" />

        <View
            android:id="@+id/vDivider"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:background="@color/gold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/checklistBtn"
            app:layout_constraintStart_toEndOf="@+id/doneBtn"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/hDivider"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/gold"
            app:layout_constraintBottom_toTopOf="@+id/editBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/doneBtn" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editBtn"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/min_touch_target"
            android:layout_height="@dimen/min_touch_target"
            android:backgroundTint="#00000000"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_edit"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="18dp"
            app:iconTint="@color/gold_light"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/vDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hDivider"
            app:rippleColor="#33D4BC7E" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteBtn"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/min_touch_target"
            android:layout_height="@dimen/min_touch_target"
            android:backgroundTint="#00000000"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="18dp"
            app:iconTint="#E8A48A"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/vDivider"
            app:layout_constraintTop_toBottomOf="@+id/hDivider"
            app:rippleColor="#44E8A48A" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
