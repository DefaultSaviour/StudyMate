<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy">

    <!-- Wood photo, centerCrop so it never stretches. Dedicated focus-timer background. -->
    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_focustimer"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/bgOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_wood_overlay"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/headerGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.16" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/focusCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="#59000000"
        app:cardForegroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:strokeColor="#99C4A24A"
        app:strokeWidth="1dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.StudyMate.LoginCard"
        app:layout_constraintWidth_max="@dimen/card_max_width"
        app:layout_constraintTop_toBottomOf="@id/headerGuide"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/focusScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="20dp"
                android:paddingBottom="16dp">

                <!-- Assignment selector (0.9J): tap to study a specific assignment.
                     Optional — left as "Choose an assignment" the timer works as before.
                     (The old title/subtitle were dropped here to minimise scrolling.) -->
                <LinearLayout
                    android:id="@+id/assignmentSelector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_focus_field"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:id="@+id/assignmentSelectorIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/assignmentSelectorText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/focus_choose_assignment"
                        android:textColor="@color/surface"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="▾"
                        android:textColor="@color/gold_light"
                        android:textSize="16sp" />

                </LinearLayout>

                <!-- Phase + round, centred above the countdown -->
                <TextView
                    android:id="@+id/phaseLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="28dp"
                    android:accessibilityHeading="true"
                    android:background="@drawable/bg_text_pill"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:letterSpacing="0.15"
                    android:text="@string/focus_phase_focus"
                    android:textColor="@color/gold_light"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/roundText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:text="@string/focus_round_default"
                    android:textColor="@color/gold_light"
                    android:textSize="14sp" />

                <!-- Big countdown with a breathing gold glow while running -->
                <FrameLayout
                    android:id="@+id/countdownContainer"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="12dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <TextView
                        android:id="@+id/countdownText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:fontFamily="monospace"
                        android:text="25:00"
                        android:textColor="@color/surface"
                        android:textSize="64sp"
                        android:textStyle="bold"
                        android:shadowColor="#99000000"
                        android:shadowRadius="8" />

                    <uws.ac.uk.studymate.ui.PulseRingView
                        android:id="@+id/countdownGlow"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                </FrameLayout>

                <!-- Editable config: tap a box to change study / break / rounds -->
                <LinearLayout
                    android:id="@+id/configRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/focus_set_study"
                            android:textColor="@color/gold_light"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/studyBox"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_focus_field"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="25"
                            android:textColor="@color/surface"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/focus_set_break"
                            android:textColor="@color/gold_light"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/breakBox"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_focus_field"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="5"
                            android:textColor="@color/surface"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/focus_set_rounds"
                            android:textColor="@color/gold_light"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/roundsBox"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_focus_field"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="4"
                            android:textColor="@color/surface"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Start / Pause (primary) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startPauseBtn"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/focus_start"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/navy"
                    android:backgroundTint="@color/gold"
                    app:cornerRadius="12dp" />

                <!-- Reset / Skip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/skipBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:text="@string/focus_end_round"
                        android:textColor="@color/gold_light"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:minWidth="0dp"
                        android:backgroundTint="#59000000"
                        app:strokeColor="@color/gold_light"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/endBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:text="@string/focus_end"
                        android:textColor="@color/gold_light"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:minWidth="0dp"
                        android:backgroundTint="#59000000"
                        app:strokeColor="@color/gold_light"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp" />

                </LinearLayout>

                <!-- Checklist (0.9J): the selected assignment's tasks, ticked off live.
                     Sits below the controls (per design) and is hidden until an
                     assignment is chosen, so the timer stays uncluttered. -->
                <LinearLayout
                    android:id="@+id/focusChecklistBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/focusChecklistLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:accessibilityHeading="true"
                            android:letterSpacing="0.15"
                            android:text="@string/focus_checklist_label"
                            android:textColor="@color/gold_light"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/focusChecklistCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 of 0"
                            android:textColor="#B2FAF8F5"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/focusChecklistAddBtn"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="@dimen/min_touch_target"
                            android:layout_height="@dimen/min_touch_target"
                            android:layout_marginStart="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:icon="@drawable/ic_add"
                            app:iconTint="@color/gold"
                            app:iconSize="22dp"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            android:backgroundTint="#00000000"
                            app:rippleColor="#33D4BC7E"
                            android:contentDescription="@string/cd_add_task" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/focusChecklistEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/focus_checklist_empty"
                        android:textColor="#B2FAF8F5"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/focusChecklistRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </com.google.android.material.card.MaterialCardView>

    <!-- Floating orbs are generated at runtime by OrbField. -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/backBtn"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_arrow_back"
        app:iconTint="@color/surface"
        app:iconSize="26dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        android:backgroundTint="#59000000"
        app:strokeColor="#99C4A24A"
        app:strokeWidth="1dp"
        app:cornerRadius="26dp"
        app:rippleColor="#33D4BC7E"
        android:contentDescription="@string/cd_back"
        app:layout_constraintBottom_toTopOf="@id/focusCard"
        app:layout_constraintEnd_toEndOf="@id/focusCard"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
