<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top|center_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_widget_glass"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp">

    <!-- Header -->
    <TextView
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This Week"
        android:textColor="@color/gold"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Calendar Grid (7 columns) -->
    <LinearLayout
        android:id="@+id/widget_calendar_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:weightSum="7">

        <!-- Day 1 -->
        <LinearLayout
            android:id="@+id/widget_day_1_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_day_1_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M"
                android:textColor="@color/gold_light"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_day_1_date"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/surface"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:minHeight="28dp">
                <ImageView android:id="@+id/widget_day_1_dot1" android:layout_width="12dp" android:layout_height="8dp" android:scaleType="centerInside" android:src="@drawable/shape_indicator_dot" android:visibility="gone" />
                <ImageView android:id="@+id/widget_day_1_dot2" android:layout_width="12dp" android:layout_height="8dp" android:layout_marginTop="2dp" android:scaleType="centerInside" android:src="@drawable/shape_indicator_dot" android:visibility="gone" />
                <ImageView android:id="@+id/widget_day_1_dot3" android:layout_width="12dp" android:layout_height="8dp" android:layout_marginTop="2dp" android:scaleType="centerInside" android:src="@drawable/shape_indicator_dot" android:visibility="gone" />
                <TextView android:id="@+id/widget_day_1_plus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/surface" android:textSize="9sp" android:textStyle="bold" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Day 2 -->
        <LinearLayout
            android:id="@+id/widget_day_2_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_day_2_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="T"
                android:textColor="@color/gold_light"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_day_2_date"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/surface"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:minHeight="28dp">
                <ImageView android:id="@+id/widget_day_2_dot1" android:layout_width="12dp" android:layout_height="8dp" android:scaleType="centerInside" android:src="@drawable/shape_indicator_dot" android:visibility="gone" />
                <ImageView android:id="@+id/widget_day_2_dot2" android:layout_width="12dp" android:layout_height="8dp" android:layout_marginTop="2dp" android:scaleType="centerInside" android:src="@drawable/shape_indicator_dot" android:visibility="gone" />
                <ImageView android:id="@+id/widget_day_2_dot3" android:layout_width="12dp" android:layout_height="8dp" android:layout_marginTop="2dp" android:scaleType="centerInside" android:src="@drawable/shape_indicator_dot" android:visibility="gone" />
                <TextView android:id="@+id/widget_day_2_plus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/surface" android:textSize="9sp" android:textStyle="bold" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Day 3 -->
        <LinearLayout
            android:id="@+id/widget_day_3_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_day_3_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="W"
                android:textColor="@color/gold_light"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_day_3_date"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/surface"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:minHeight="28dp">
                <ImageView android:id="@+id/widget_day_3_dot1" android:layout_width="12dp" android:layout_height="8dp" android:scaleType="centerInside" android:src="@drawable/shape_indicator_dot" android:visibility="gone" />
                <ImageView android:id="@+id/widget_day_3_dot2" android:layout_width="12dp" android:layout_height="8dp" android:layout_marginTop="2dp" android:scaleType="centerInside" android:src="@drawable/shape_indicator_dot" android:visibility="gone" />
                <ImageView android:id="@+id/widget_day_3_dot3" android:layout_width="12dp" android:layout_height="8dp" android:layout_marginTop="2dp" android:scaleType="centerInside" android:src="@drawable/shape_indicator_dot" android:visibility="gone" />
                <TextView android:id="@+id/widget_day_3_plus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/surface" android:textSize="9sp" android:textStyle="bold" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Day 4 -->
        <LinearLayout
            android:id="@+id/widget_day_4_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_day_4_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="T"
                android:textColor="@color/gold_light"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_day_4_date"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/surface"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:minHeight="28dp">
                <ImageView android:id="@+id/widget_day_4_dot1" android:layout_width="12dp" android:layout_height="8dp" android:scaleType="centerInside" android:src="@drawable/shape_indicator_dot" android:visibility="gone" />
                <ImageView android:id="@+id/widget_day_4_dot2" android:layout_width="12dp" android:layout_height="8dp" android:layout_marginTop="2dp" android:scaleType="centerInside" android:src="@drawable/shape_indicator_dot" android:visibility="gone" />
                <ImageView android:id="@+id/widget_day_4_dot3" android:layout_width="12dp" android:layout_height="8dp" android:layout_marginTop="2dp" android:scaleType="centerInside" android:src="@drawable/shape_indicator_dot" android:visibility="gone" />
                <TextView android:id="@+id/widget_day_4_plus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/surface" android:textSize="9sp" android:textStyle="bold" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Day 5 -->
        <LinearLayout
            android:id="@+id/widget_day_5_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_day_5_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="F"
                android:textColor="@color/gold_light"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_day_5_date"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="5"
                android:textColor="@color/surface"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:minHeight="28dp">
                <ImageView android:id="@+id/widget_day_5_dot1" android:layout_width="12dp" android:layout_height="8dp" android:scaleType="centerInside" android:src="@drawable/shape_indicator_dot" android:visibility="gone" />
                <ImageView android:id="@+id/widget_day_5_dot2" android:layout_width="12dp" android:layout_height="8dp" android:layout_marginTop="2dp" android:scaleType="centerInside" android:src="@drawable/shape_indicator_dot" android:visibility="gone" />
                <ImageView android:id="@+id/widget_day_5_dot3" android:layout_width="12dp" android:layout_height="8dp" android:layout_marginTop="2dp" android:scaleType="centerInside" android:src="@drawable/shape_indicator_dot" android:visibility="gone" />
                <TextView android:id="@+id/widget_day_5_plus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/surface" android:textSize="9sp" android:textStyle="bold" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Day 6 -->
        <LinearLayout
            android:id="@+id/widget_day_6_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_day_6_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S"
                android:textColor="@color/gold_light"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_day_6_date"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="6"
                android:textColor="@color/surface"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:minHeight="28dp">
                <ImageView android:id="@+id/widget_day_6_dot1" android:layout_width="12dp" android:layout_height="8dp" android:scaleType="centerInside" android:src="@drawable/shape_indicator_dot" android:visibility="gone" />
                <ImageView android:id="@+id/widget_day_6_dot2" android:layout_width="12dp" android:layout_height="8dp" android:layout_marginTop="2dp" android:scaleType="centerInside" android:src="@drawable/shape_indicator_dot" android:visibility="gone" />
                <ImageView android:id="@+id/widget_day_6_dot3" android:layout_width="12dp" android:layout_height="8dp" android:layout_marginTop="2dp" android:scaleType="centerInside" android:src="@drawable/shape_indicator_dot" android:visibility="gone" />
                <TextView android:id="@+id/widget_day_6_plus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/surface" android:textSize="9sp" android:textStyle="bold" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Day 7 -->
        <LinearLayout
            android:id="@+id/widget_day_7_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_day_7_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S"
                android:textColor="@color/gold_light"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_day_7_date"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="7"
                android:textColor="@color/surface"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:minHeight="28dp">
                <ImageView android:id="@+id/widget_day_7_dot1" android:layout_width="12dp" android:layout_height="8dp" android:scaleType="centerInside" android:src="@drawable/shape_indicator_dot" android:visibility="gone" />
                <ImageView android:id="@+id/widget_day_7_dot2" android:layout_width="12dp" android:layout_height="8dp" android:layout_marginTop="2dp" android:scaleType="centerInside" android:src="@drawable/shape_indicator_dot" android:visibility="gone" />
                <ImageView android:id="@+id/widget_day_7_dot3" android:layout_width="12dp" android:layout_height="8dp" android:layout_marginTop="2dp" android:scaleType="centerInside" android:src="@drawable/shape_indicator_dot" android:visibility="gone" />
                <TextView android:id="@+id/widget_day_7_plus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/surface" android:textSize="9sp" android:textStyle="bold" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FAF8F5"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Upcoming Assignment -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next Assignment"
            android:textColor="@color/gold_light"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/widget_next_assignment_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No upcoming assignments"
            android:textColor="@color/surface"
            android:textSize="16sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="2" />

        <TextView
            android:id="@+id/widget_next_assignment_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add one in the app"
            android:textColor="@color/gold_light"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FAF8F5"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Flashcards Footer -->
    <LinearLayout
        android:id="@+id/widget_flashcards_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Flashcards Due Today"
            android:textColor="@color/surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_flashcards_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/gold"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    </LinearLayout>

</LinearLayout>
