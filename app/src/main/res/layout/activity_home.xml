<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_combined">

    <!-- Guideline: card starts ~16% from top so the wood band above shows the orbs -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/headerGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.16" />

    <!-- ===== GLASS CARD — nearly full screen ===== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/homeCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="#59000000"
        app:cardForegroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:strokeColor="#99C4A24A"
        app:strokeWidth="1dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.StudyMate.LoginCard"
        app:layout_constraintTop_toBottomOf="@id/headerGuide"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/homeScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="20dp"
                android:paddingBottom="0dp">

                <!-- Next due section -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/nextDueContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#33000000"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#33C4A24A"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NEXT DUE"
                            android:textSize="12sp"
                            android:letterSpacing="0.15"
                            android:textColor="@color/gold_light"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/nextDueCountdownText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No due assignments yet"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/surface" />

                        <TextView
                            android:id="@+id/nextDueDetailsText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Add an assignment to see your next deadline here."
                            android:textSize="14sp"
                            android:textColor="#B2FAF8F5"
                            android:layout_marginTop="6dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Divider -->
                <View
                    android:id="@+id/navDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#33FAF8F5"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="14dp" />

                <!-- Section label with pill background -->
                <TextView
                    android:id="@+id/navSectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STUDY AREAS"
                    android:textSize="12sp"
                    android:letterSpacing="0.15"
                    android:textColor="@color/gold_light"
                    android:background="@drawable/bg_text_pill_subtle"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginBottom="10dp" />

                <!-- Navigation buttons -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/assignmentsBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="Assignments"
                    android:textColor="@color/gold_light"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:backgroundTint="#59000000"
                    app:strokeColor="@color/gold_light"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp"
                    app:rippleColor="#33D4BC7E" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/flashcardsBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="Flashcards"
                    android:textColor="@color/gold_light"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:backgroundTint="#59000000"
                    app:strokeColor="@color/gold_light"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp"
                    app:rippleColor="#33D4BC7E" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/calendarBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="Calendar"
                    android:textColor="@color/gold_light"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:backgroundTint="#59000000"
                    app:strokeColor="@color/gold_light"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp"
                    app:rippleColor="#33D4BC7E" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/statisticsBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="Statistics"
                    android:textColor="@color/gold_light"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:backgroundTint="#59000000"
                    app:strokeColor="@color/gold_light"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp"
                    app:rippleColor="#33D4BC7E" />

                <!-- Review-due-decks: only enabled when cards are due. The PulseRingView
                     overlay paints a travelling gold glow around the ring when active.
                     It is non-clickable, so taps fall through to the button beneath. -->
                <FrameLayout
                    android:id="@+id/reviewDueContainer"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/reviewDueBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Review due decks"
                        android:textColor="@color/gold_light"
                        android:textSize="18sp"
                        android:gravity="center"
                        android:backgroundTint="#59000000"
                        app:strokeColor="@color/gold_light"
                        app:strokeWidth="1dp"
                        app:cornerRadius="12dp"
                        app:rippleColor="#33D4BC7E" />

                    <uws.ac.uk.studymate.ui.PulseRingView
                        android:id="@+id/reviewDueGlow"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </com.google.android.material.card.MaterialCardView>

    <!-- Floating orbs are generated at runtime by OrbField (scaled to the wood
         band above the card, clear of the settings button). -->

    <!-- ===== SETTINGS ICON — top-right, floats over everything ===== -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/userSettingsBtn"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_person"
        app:iconTint="@color/surface"
        app:iconSize="28dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        android:backgroundTint="#59000000"
        app:strokeColor="#99C4A24A"
        app:strokeWidth="1dp"
        app:cornerRadius="26dp"
        app:rippleColor="#33D4BC7E"
        app:layout_constraintBottom_toTopOf="@id/homeCard"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
