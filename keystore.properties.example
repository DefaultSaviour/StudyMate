# Copy this file to `keystore.properties` (same folder, repo root) and fill in
# your real values. keystore.properties is gitignored — never commit it or the
# .jks file. See RELEASE.md for how to generate the keystore.

storeFile=../studymate-release.jks
storePassword=CHANGE_ME
keyAlias=studymate
keyPassword=CHANGE_ME
